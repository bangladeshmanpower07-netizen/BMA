              <div class="col-md-6">
                <label class="form-label small fw-semibold">Target Transaction ID Code</label>
                <input type="text" name="transaction_id" class="form-control" placeholder="66b01..." required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold">Dispute Reason Category</label>
                <select class="form-select" name="reason" required>
                  <option value="Item not delivered">Merchant item not delivered</option>
                  <option value="Defective services">Merchant services defect/unfulfilled</option>
                  <option value="Unauthorized ledger billing">Unauthorized ledger payment billing</option>
                </select>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Register Secure Dispute File</button>
              </div>
            </div>
          </form>
        </div>
      <% } %>

      <div class="card p-4 shadow-sm">
        <h5 class="fw-bold mb-4">Platform Dispute Files</h5>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Dispute ID</th>
                <th>Transaction Code</th>
                <th>Dispute Details</th>
                <th>Status</th>
                <th>Opening Date</th>
                <% if (user.role === 'admin') { %>
                  <th>Admin Action</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% if (disputes && disputes.length > 0) { %>
                <% disputes.forEach(disp => { %>
                  <tr>
                    <td><code><%= disp.dispute_id %></code></td>
                    <td><code><%= disp.transaction_id %></code></td>
                    <td class="small">
                      <strong class="text-dark d-block"><%= disp.reason %></strong>
                      <span class="text-muted">User ID: <%= disp.user_id %></span>
                    </td>
                    <td>
                      <span class="badge bg-warning text-dark text-capitalize"><%= disp.status %></span>
                    </td>
                    <td class="small text-muted"><%= new Date(disp.created_at).toLocaleDateString() %></td>
                    <% if (user.role === 'admin') { %>
                      <td>
                        <form action="/api/admin/disputes/resolve" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="dispute_id" value="<%= disp.dispute_id %>">
                          <button type="submit" name="resolution" value="approved" class="btn btn-success btn-sm me-1"><i class="fa-solid fa-check me-1"></i>Refund User</button>
                          <button type="submit" name="resolution" value="rejected" class="btn btn-danger btn-sm"><i class="fa-solid fa-xmark me-1"></i>Reject</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="<%= user.role === 'admin' ? 6 : 5 %>" class="text-center py-4 text-muted">No open active disputes found on the ledger.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>


    <!-- ---------------- KYC PAGE ---------------- -->
    <% if (page === 'kyc') { %>
      <% if (user.role === 'user') { %>
        <div class="row justify-content-center">
          <div class="col-md-8">
            <div class="card p-4 shadow-sm text-center">
              <h5 class="fw-bold mb-3 text-indigo">KYC Financial Profile Verification</h5>
              <p class="text-muted small mb-4">Regulatory standards mandate valid government ID verification files prior to outgoing QR store payment transfers.</p>
              
              <div class="p-3 bg-light rounded-3 mb-4 text-start border">
                <h6 class="fw-bold text-dark">Identity Status Check:</h6>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <span>Current KYC State:</span>
