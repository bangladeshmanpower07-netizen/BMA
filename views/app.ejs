                  <input type="number" name="amount_bmc" class="form-control" placeholder="100" min="100" required>
                  <span class="input-group-text bg-light">BMC</span>
                </div>
                <div class="form-text text-muted">Conversion Value: 1 BMC = 16 BDT. Minimum Settlement Limit: 100 BMC</div>
              </div>

              <div class="mb-4">
                <label class="form-label small fw-semibold">Settlement Account Details</label>
                <input type="text" class="form-control" value="BRAC Bank BD, A/C No: 151210******492" disabled>
              </div>

              <button type="submit" class="btn btn-primary py-2 w-100 fw-bold">Initiate Financial Settlement Request</button>
            </form>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-3 text-indigo">Auto-Settlement Engine Configurations</h5>
            <p class="text-muted small">Configure auto-settlement rules to dynamically run cron payouts whenever balances exceed targets.</p>
            
            <form action="/api/merchant/auto-settle" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Automated Settlement Routing</label>
                <select class="form-select" name="auto_settlement">
                  <option value="true" <%= merchant.auto_settlement ? 'selected' : '' %>>ON - Process Auto settlements</option>
                  <option value="false" <%= !merchant.auto_settlement ? 'selected' : '' %>>OFF - Manual Payout Processing Only</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-semibold">Trigger Frequency</label>
                <select class="form-select" name="settlement_frequency">
                  <option value="daily" <%= merchant.settlement_frequency === 'daily' ? 'selected' : '' %>>Daily Payout Batch</option>
                  <option value="weekly" <%= merchant.settlement_frequency === 'weekly' ? 'selected' : '' %>>Weekly Payout Batch</option>
                </select>
              </div>
              <div class="mb-4">
                <label class="form-label small fw-semibold">Minimum Amount Balance Threshold (BMC)</label>
                <input type="number" name="min_settlement_amount" class="form-control" value="<%= merchant.min_settlement_amount || 100 %>" min="100">
              </div>
              <button type="submit" class="btn btn-dark py-2 w-100">Save Configuration Preferences</button>
            </form>
          </div>
        </div>
      </div>

      <div class="card p-4 shadow-sm">
        <h5 class="fw-bold mb-4">Payout Settlement History</h5>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Settlement ID</th>
                <th>Amount (BMC)</th>
                <th>Amount (BDT)</th>
                <th>Status</th>
                <th>Processing Provider</th>
                <th>Request Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (settlements && settlements.length > 0) { %>
                <% settlements.forEach(st => { %>
                  <tr>
                    <td><code><%= st.settlement_id %></code></td>
                    <td class="fw-bold text-dark"><%= st.amount_bmc %> BMC</td>
                    <td class="text-muted">৳ <%= st.amount_bdt %></td>
                    <td>
                      <span class="badge <%= st.status === 'completed' ? 'badge-completed' : (st.status === 'failed' ? 'badge-danger' : 'badge-warning') %> text-capitalize">
                        <%= st.status %>
                      </span>
                    </td>
                    <td><%= st.provider || 'Core Bank settlement' %></td>
                    <td class="small text-muted"><%= new Date(st.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No historical payouts found on this merchant wallet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>


    <!-- ---------------- DISPUTES PAGE ---------------- -->
    <% if (page === 'disputes') { %>
      <% if (user.role === 'user') { %>
        <div class="card p-4 shadow-sm mb-4">
          <h5 class="fw-bold text-indigo mb-3">File Customer Purchase Dispute</h5>
          <p class="text-muted small">Has a merchant failed to deliver on products or orders processed inside the BMA application? Fill out this record form below to request a direct escrow reversal.</p>
          <form action="/api/disputes/create" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
