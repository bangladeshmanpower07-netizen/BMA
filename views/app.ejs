                      <input type="text" name="identification_number" class="form-control" placeholder="199540023..." required>
                    </div>
                    <div class="col-md-12">
                      <label class="form-label small fw-semibold">Verify Full Registered Address</label>
                      <textarea class="form-control" name="address" rows="2" placeholder="House 12, Road 4, Sector 3, Uttara, Dhaka" required></textarea>
                    </div>
                  </div>
                  <button type="submit" class="btn btn-primary w-100 mt-4 py-2 fw-bold">Submit KYC Documents</button>
                </form>
              <% } else { %>
                <div class="alert alert-info py-3 mb-0 d-flex align-items-center" role="alert">
                  <i class="fa-solid fa-hourglass-half me-3 fs-4"></i>
                  <div class="text-start">
                    <strong class="d-block">Documentation Under Review</strong>
                    <span class="small">Our compliance teams are auditing your identity metadata. Your limits will activate shortly.</span>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

      <% if (user.role === 'admin') { %>
        <div class="card p-4 shadow-sm">
          <h5 class="fw-bold mb-4">Pending KYC Document Queue</h5>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>User ID</th>
                  <th>Legal Name</th>
                  <th>ID Document Details</th>
                  <th>Verification Address</th>
                  <th>Queue Status</th>
                  <th>Admin Compliance Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (pendingKyc && pendingKyc.length > 0) { %>
                  <% pendingKyc.forEach(k => { %>
                    <tr>
                      <td><code><%= k.user_id %></code></td>
                      <td class="fw-bold"><%= k.full_name || 'Individual Profile' %></td>
                      <td><span class="badge bg-dark text-uppercase"><%= k.identification_type %></span>: <code><%= k.identification_number %></code></td>
                      <td class="small"><%= k.address %></td>
                      <td><span class="badge bg-warning text-dark">Pending Audit</span></td>
                      <td>
                        <form action="/api/admin/kyc/review" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="user_id" value="<%= k.user_id %>">
                          <button type="submit" name="status" value="verified" class="btn btn-success btn-sm me-1"><i class="fa-solid fa-check me-1"></i>Approve</button>
                          <button type="submit" name="status" value="rejected" class="btn btn-danger btn-sm"><i class="fa-solid fa-xmark me-1"></i>Reject</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">All active KYC files are processed and audited.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    <% } %>


    <!-- ---------------- KYB PAGE ---------------- -->
