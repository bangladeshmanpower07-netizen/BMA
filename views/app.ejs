                </div>
              </div>

              <% if (!kyc || kyc.status === 'not_started' || kyc.status === 'rejected') { %>
                <form action="/api/kyc/submit" method="POST" class="text-start">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label small fw-semibold">ID Documentation Type</label>
                      <select class="form-select" name="identification_type" required>
                        <option value="nid">National Identification Card (NID)</option>
                        <option value="passport">Government Passport</option>
                      </select>
