                      <td><code><%= b.trade_license_metadata || 'Not Provided' %></code></td>
                      <td class="small"><%= b.business_address %></td>
                      <td><span class="badge bg-warning text-dark">Pending Audit</span></td>
                      <td>
                        <form action="/api/admin/kyb/review" method="POST" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="merchant_id" value="<%= b.merchant_id %>">
                          <button type="submit" name="status" value="approved" class="btn btn-success btn-sm me-1"><i class="fa-solid fa-check me-1"></i>Approve</button>
                          <button type="submit" name="status" value="rejected" class="btn btn-danger btn-sm"><i class="fa-solid fa-xmark me-1"></i>Reject</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-muted">All business registration files are approved and reconciled.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    <% } %>


    <!-- ---------------- RISK & AUDIT PAGE (ADMIN ONLY) ---------------- -->
    <% if (page === 'risk' && user.role === 'admin') { %>
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <div class="card p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i>Security & Risk Engine Alerts</h5>
            <p class="text-muted small">Automated filters and velocity monitoring systems flag anomalous or out-of-bounds transfers here.</p>
            <div class="table-responsive">
              <table class="table table-hover align-middle small">
                <thead class="table-light">
                  <tr>
                    <th>Alert Type</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (riskAlerts && riskAlerts.length > 0) { %>
                    <% riskAlerts.forEach(alert => { %>
                      <tr>
                        <td class="fw-bold text-dark"><code><%= alert.type %></code></td>
                        <td><span class="badge bg-danger"><%= alert.severity %></span></td>
                        <td><span class="text-uppercase small"><%= alert.status %></span></td>
                        <td class="small text-muted"><%= alert.description %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center py-3 text-muted">No security alerts detected.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-3 text-indigo"><i class="fa-solid fa-shield-halved me-2"></i>Security Controls</h5>
            <p class="text-muted small">Manage account locks and restrict nodes violating platform transaction integrity protocols.</p>
            <form action="/api/admin/user/lock" method="POST" class="mb-3">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="row g-2">
                <div class="col-md-8">
                  <input type="text" name="user_id" class="form-control" placeholder="User Profile ID Code" required>
                </div>
                <div class="col-md-4">
                  <button type="submit" class="btn btn-danger w-100">Freeze User</button>
                </div>
              </div>
            </form>
            <form action="/api/admin/user/unlock" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="row g-2">
                <div class="col-md-8">
                  <input type="text" name="user_id" class="form-control" placeholder="User Profile ID Code" required>
                </div>
                <div class="col-md-4">
                  <button type="submit" class="btn btn-success w-100">Unfreeze User</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="card p-4 shadow-sm">
        <h5 class="fw-bold mb-4"><i class="fa-solid fa-list-check me-2"></i>Immutable System Action Logs</h5>
        <div class="table-responsive">
          <table class="table table-hover align-middle small">
            <thead class="table-light">
              <tr>
                <th>Actor Profile ID</th>
                <th>Action Module</th>
                <th>Target Node</th>
                <th>Network IP</th>
                <th>Agent Headers</th>
                <th>Transaction Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (auditLogs && auditLogs.length > 0) { %>
                <% auditLogs.forEach(log => { %>
                  <tr>
                    <td><code><%= log.actor_id %></code> <span class="badge bg-secondary text-uppercase"><%= log.actor_role %></span></td>
                    <td class="fw-bold text-indigo"><%= log.action %></td>
                    <td><code><%= log.target_id || 'System Core' %></code></td>
                    <td><code><%= log.ip %></code></td>
                    <td class="small text-muted"><%= log.user_agent.substring(0, 30) %>...</td>
                    <td class="small text-muted"><%= new Date(log.created_at).toLocaleString() %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No security actions recorded in the log files.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>


    <!-- ---------------- SECURITY MANAGEMENT PAGE ---------------- -->
    <% if (page === 'security') { %>
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card p-4 shadow-sm">
            <h5 class="fw-bold mb-3 text-indigo">Change Account Password</h5>
            <form action="/api/security/password" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label class="form-label small fw-semibold">Current Secure Password</label>
                <input type="password" name="current_password" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label small fw-semibold">New System Password</label>
                <input type="password" name="new_password" class="form-control" minlength="6" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Update Secure Password</button>
            </form>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card p-4 shadow-sm">
            <h5 class="fw-bold mb-3 text-indigo">Active Device Sessions</h5>
            <p class="text-muted small">Manage secure session states and cookies across authorized terminals.</p>
            <div class="p-3 bg-light rounded-3 mb-3 border">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <strong class="d-block text-dark">Active Session Terminal (This Device)</strong>
                  <span class="small text-muted">IP Location Node: <%= user.last_login ? 'Active Terminal Session' : 'Pending Verification' %></span>
                </div>
                <span class="badge bg-success">Current Terminal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>


    <!-- ---------------- NOTIFICATIONS PAGE ---------------- -->
    <% if (page === 'notifications') { %>
      <div class="card p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
          <h5 class="fw-bold m-0"><i class="fa-solid fa-bell me-2"></i>Platform Security Notifications</h5>
          <form action="/api/notifications/read" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline-indigo border btn-sm">Mark All as Read</button>
          </form>
        </div>
        <div class="list-group list-group-flush">
          <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(note => { %>
              <div class="list-group-item py-3 <%= !note.is_read ? 'bg-light border-start border-primary border-4' : '' %>">
                <div class="d-flex justify-content-between mb-1">
                  <h6 class="fw-bold text-dark mb-0 text-capitalize"><%= note.title %></h6>
                  <span class="small text-muted"><%= new Date(note.created_at).toLocaleDateString() %></span>
                </div>
                <p class="text-muted small mb-0"><%= note.message %></p>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-5 text-muted">
              <i class="fa-solid fa-bell-slash fs-2 mb-3 d-block text-muted"></i>
              No unread security or payment alerts.
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Conditional Dashboard Charts Scripts -->
  <% if (page === 'dashboard' && user.role === 'user') { %>
    <script>
      const ctxUser = document.getElementById('userTrendChart').getContext('2d');
      new Chart(ctxUser, {
        type: 'line',
        data: {
          labels: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          datasets: [{
            label: 'Transaction Value (BMC)',
            data: [10, 30, 15, 80, 50, 120, <%= stats.wallet.balance_bmc %>],
            borderColor: '#4F46E5',
            backgroundColor: 'rgba(79, 70, 229, 0.05)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    </script>
  <% } %>

  <% if (page === 'dashboard' && user.role === 'merchant') { %>
    <script>
      const ctxMerchant = document.getElementById('merchantSalesChart').getContext('2d');
      new Chart(ctxMerchant, {
        type: 'bar',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Sales Vol (BMC)',
            data: [20, 45, 30, 90, 60, 150, <%= stats.totalSales || 0 %>],
            backgroundColor: '#10B981',
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    </script>
  <% } %>

</body>
</html>
